# ===================================================
# Just Like Home Nursery - Client Environment Variables
# ===================================================

# For Decoupled Production Deployments (e.g. Vercel / Netlify Frontend + Render Backend):
# Set this to the live URL of your deployed Express backend (without trailing slash)
# Example: VITE_API_URL=https://jlh-nursery-api.onrender.com
#
# For Local Development or Monolith Deployments (both served together on same domain):
# Leave empty or omitted, and the frontend will use the local proxy or relative '/api' path.
VITE_API_URL=
