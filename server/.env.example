# ===================================================
# Just Like Home Nursery - Server Environment Variables
# ===================================================

# Server Port (assigned automatically by cloud hosts like Render/Railway/Heroku)
PORT=5000
NODE_ENV=production

# ==================== MONGODB ATLAS CONFIGURATION ====================
# Replace with your MongoDB Atlas connection string from cloud.mongodb.com:
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/jlh_nursery?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/jlh_nursery?retryWrites=true&w=majority

# ==================== CORS CONFIGURATION ====================
# Allowed frontend origins. Use comma-separated list for specific domains or * for all:
# Example for custom domain: CORS_ORIGIN=https://jlhnursery.ae,https://www.jlhnursery.ae,https://jlh-nursery.vercel.app
CORS_ORIGIN=*

# ==================== NURSERY CONTACT INFORMATION ====================
NURSERY_PHONE=0502005346
NURSERY_EMAIL=deevan.aumdsorg@gmail.com
FORM_RECEIVER_EMAIL=deevan.aumdsorg@gmail.com
NURSERY_ADDRESS=Villa No. 47, Al Rashidiya 2, Ajman, UAE

# ==================== EMAIL SMTP (Optional for automated mail dispatch) ====================
